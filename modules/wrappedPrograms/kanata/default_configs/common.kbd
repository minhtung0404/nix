
(environment (OS darwin)

(defalias
  fn-mac fn
  fn (tap-hold-press 200 200 fn (layer-while-held fn_layer))
)
)

(environment (OS linux)

(defalias
  fn-mac XX
  fn XX
)
)

(defalias
  cmd lmet
  alt lalt
  eoc (tap-hold-press 200 200 esc lctl)
  ctl (tap-hold-press 200 200 @fn-mac (layer-while-held fn_layer))
)

(environment (OS darwin)
(defoverrides
  (lctl a) (lmet a)
  (lctl c) (lmet c)
  (lctl s) (lmet s)
  (lctl t) (lmet t)
  (lctl v) (lmet v)
  (lctl w) (lmet w)
  (lctl x) (lmet x)
  (lctl z) (lmet z)
)
)

(environment (OS linux)

(defoverrides
  (lmet a) (lctl a)
  (lmet c) (lctl c)
  (lmet s) (lctl s)
  (lmet t) (lctl t)
  (lmet v) (lctl v)
  (lmet w) (lctl w)
  (lmet x) (lctl x)
  (lmet z) (lctl z)
)
)

(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @eoc a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  @ctl @alt @cmd           spc            @alt @cmd rctl
  @fn  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
)

(deflayermap fn_layer
  f1 brdn
  f2 brup
  f7 prev
  f8 pp
  f9 next
  f10 mute
  f11 vold
  f12 volu
  esc lrld-next
  1 brdn
  2 brup
  0 mute
  - vold
  = volu
  spc @fn-mac
  ___ XX
)

